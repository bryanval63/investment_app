generator client {
  provider = "prisma-client-js"
  output = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

enum IncomeType {
  SALARY
  PEE
  RESTAURANT_TICKETS
  BONUS
  APL
  PARKING_RENT
  SCPI
}

model IncomeTypeRef {
  id Int @default(autoincrement()) @id
  code IncomeType @unique
  label String 
  incomes Income[]
}

model Income {
  id Int @default(autoincrement()) @id
  type IncomeTypeRef @relation(fields: [typeId], references: [id])
  typeId  Int
  amount Decimal @default(0)
  date DateTime
}

model Tax {
  id Int @default(autoincrement()) @id
  amount Decimal @default(0)
  year Int
}

model InvestmentTypeRef {
  id Int @default(autoincrement()) @id
  code String @unique
  label String 
  accounts Account[]
}

model InvestmentCategoryRef {
  id Int @default(autoincrement()) @id
  code String @unique
  label String
}

model Account {
  id Int @default(autoincrement()) @id
  type InvestmentTypeRef @relation(fields: [typeId], references: [id])
  typeId Int
  name String
  investments Investment[]
  category String @default("STOCK")
  isClosed Boolean @default(false)
}

model Investment {
  id Int @default(autoincrement()) @id
  account Account @relation(fields: [accountId], references: [id])
  accountId Int
  totalAmount Decimal @default(0)
  capitalGain Decimal @default(0)
  transactionAmount Decimal @default(0)
  date DateTime
}

model NetWorth {
  id Int @default(autoincrement()) @id
  amount Decimal @default(0)
  date DateTime
}

model InvestmentSetting {
  id        Int    @default(autoincrement()) @id
  key       String
  scope     String @default("GLOBAL")
  value     Float
  @@unique([key, scope])
}